# EARMS — Apache config for https://earmshub.com (static hosting).
# Place: this file ships as public/.htaccess -> dist/.htaccess.
# Upload the BUILD OUTPUT (dist/*) to the domain docroot (public_html),
# including this .htaccess next to index.html.
#
# What it does:
#   1. Forces HTTPS (APIs + auth tokens require it).
#   2. SPA fallback: non-file requests serve index.html (hash router works
#      without this, but deep links / future BrowserRouter need it).
#   3. Long-caches hashed Vite assets (/assets/*) for performance.
#
# What it does NOT do:
#   No /api/* reverse-proxy. The frontend calls backends directly on
#   earmshub.com (see src/api-config.js) because shared hosting rarely
#   allows mod_proxy, and backends already CORS-allow https://earmshub.com.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA fallback — serve index.html for non-files (skip existing files/dirs)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Never serve git metadata when the docroot itself is a pull checkout.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
</IfModule>

# Cache hashed build assets for 1 year (filenames change each build, safe).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
